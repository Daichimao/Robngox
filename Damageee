 crit_multiplier("tok-kw">float): Berapa kali lipat damage saat kritikal. Default 2x.
 element_multiplier("tok-kw">float): Modifier elemen(api, es, dll). Default 1x.
 other_multipliers(dict): Dictionary untuk multiplier lain(misal: boss weakness, status effect).
 
 Returns:
 dict: Dictionary berisi detail perhitungan(Normal Damage, Crit Damage, Total Expected Value).
 """
 "tok-kw">if other_multipliers "tok-kw">is "tok-kw">None:
 other_multipliers = {}

 # 1. Hitung Total Attack Stats
 total_attack_mult = 1.0 + "tok-kw">self.attack_bonus_percent
 effective_attack = "tok-kw">self.base_attack  total_attack_mult

 # Terapkan multiplier elemen
 effective_attack = element_multiplier

 # Terapkan multiplier lainnya(jika ada)
 "tok-kw">for key, value "tok-kw">in other_multipliers.items():
 effective_attack = value

 # 2. Hitung Normal Damage
